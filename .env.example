INDEXER_ENABLED=true

# 1 = mainnet, 5 = fuji
AVAX_NETWORK_ID=5

# Node / indexer exposed ports
AVAX_HTTP_PORT=9650
AVAX_STAKING_PORT=9651
INDEXER_API_PORT=8080

# Logging
AVAX_LOG_LEVEL=info
AVAX_LOG_FORMAT=json

# TimescaleDB credentials
POSTGRES_DB=avalanche_indexer
POSTGRES_USER=indexer
POSTGRES_PASSWORD=indexer_pass
POSTGRES_PORT=5432

# Optional override. If unset, compose derives DATABASE_URL from POSTGRES_* values.
DATABASE_URL=postgres://indexer:indexer_pass@indexer-db:5432/avalanche_indexer

# Monitoring ports and Grafana bootstrap credentials
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change_me
